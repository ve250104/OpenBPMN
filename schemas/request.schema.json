            "targetRef": {
              "$ref": "#/$defs/key"
            },
            "direction": {
              "enum": ["none", "one", "both"]
            }
          },
          "required": ["key", "type", "containerRef", "sourceRef", "targetRef"]
        }
      ]
    },
    "artifact": {
      "oneOf": [
        {
          "$ref": "#/$defs/documentationArtifact"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "$ref": "#/$defs/key"
            },
            "name": {
              "$ref": "#/$defs/name"
            },
            "documentation": {
              "$ref": "#/$defs/text"
            },
            "type": {
              "const": "dataObject"
            },
            "containerRef": {
              "$ref": "#/$defs/key"
            },
            "isCollection": {
              "type": "boolean"
            }
          },
          "required": ["key", "type", "containerRef"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
