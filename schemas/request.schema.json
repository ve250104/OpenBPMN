          "required": ["key", "type", "containerRef"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "$ref": "#/$defs/key"
            },
            "name": {
              "$ref": "#/$defs/name"
            },
            "documentation": {
              "$ref": "#/$defs/text"
            },
            "containerRef": {
              "$ref": "#/$defs/key"
            },
            "type": {
              "enum": ["startEvent", "intermediateCatchEvent"]
            },
            "event": {
              "$ref": "#/$defs/event"
            }
          },
          "required": ["key", "type", "containerRef", "event"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "$ref": "#/$defs/key"
            },
            "name": {
              "$ref": "#/$defs/name"
            },
            "documentation": {
              "$ref": "#/$defs/text"
