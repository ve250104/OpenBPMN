              },
              "minItems": 1,
              "maxItems": 2000,
              "uniqueItems": true
            }
          },
          "required": ["key", "type", "containerRef", "categoryRef", "memberRefs"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "$ref": "#/$defs/key"
            },
            "documentation": {
              "$ref": "#/$defs/text"
            },
            "type": {
