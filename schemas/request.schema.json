            "containerRef": {
              "$ref": "#/$defs/key"
            },
            "loop": {
              "$ref": "#/$defs/loop"
            },
            "defaultFlowRef": {
              "$ref": "#/$defs/key"
            },
            "type": {
              "enum": ["task", "userTask", "manualTask", "serviceTask", "businessRuleTask", "scriptTask", "subProcess"]
            }
          },
          "required": ["key", "type", "containerRef"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "$ref": "#/$defs/key"
            },
            "name": {
              "$ref": "#/$defs/name"
            },
            "documentation": {
              "$ref": "#/$defs/text"
            },
            "containerRef": {
              "$ref": "#/$defs/key"
            },
            "loop": {
              "$ref": "#/$defs/loop"
            },
            "defaultFlowRef": {
              "$ref": "#/$defs/key"
            },
            "type": {
              "enum": ["sendTask", "receiveTask"]
            },
            "messageRef": {
              "$ref": "#/$defs/key"
            }
          },
          "required": ["key", "type", "containerRef"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "$ref": "#/$defs/key"
            },
            "name": {
              "$ref": "#/$defs/name"
            },
            "documentation": {
              "$ref": "#/$defs/text"
            },
            "containerRef": {
              "$ref": "#/$defs/key"
            },
            "loop": {
              "$ref": "#/$defs/loop"
            },
            "defaultFlowRef": {
              "$ref": "#/$defs/key"
            },
            "type": {
              "const": "callActivity"
            },
            "calledProcessRef": {
              "$ref": "#/$defs/key"
            }
          },
          "required": ["key", "type", "containerRef", "calledProcessRef"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "$ref": "#/$defs/key"
            },
            "name": {
              "$ref": "#/$defs/name"
            },
            "documentation": {
              "$ref": "#/$defs/text"
            },
            "containerRef": {
              "$ref": "#/$defs/key"
            },
            "type": {
              "enum": ["exclusiveGateway", "inclusiveGateway"]
            },
            "defaultFlowRef": {
              "$ref": "#/$defs/key"
            }
          },
          "required": ["key", "type", "containerRef"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "$ref": "#/$defs/key"
            },
            "name": {
              "$ref": "#/$defs/name"
            },
            "documentation": {
              "$ref": "#/$defs/text"
            },
            "containerRef": {
              "$ref": "#/$defs/key"
            },
            "type": {
              "const": "parallelGateway"
            }
          },
          "required": ["key", "type", "containerRef"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "$ref": "#/$defs/key"
            },
            "name": {
              "$ref": "#/$defs/name"
            },
            "documentation": {
              "$ref": "#/$defs/text"
            },
            "containerRef": {
              "$ref": "#/$defs/key"
            },
            "type": {
              "const": "eventBasedGateway"
            },
            "instantiate": {
              "type": "boolean"
            },
            "eventGatewayType": {
              "enum": ["Exclusive", "Parallel"]
            }
