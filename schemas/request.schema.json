            "containerRef": {
              "$ref": "#/$defs/key"
            },
            "dataObjectRef": {
              "$ref": "#/$defs/key"
            },
            "state": {
              "$ref": "#/$defs/name"
            }
          },
          "required": ["key", "type", "containerRef", "dataObjectRef"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "$ref": "#/$defs/key"
            },
