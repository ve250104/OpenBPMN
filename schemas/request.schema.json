{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openbpmn:schema:request:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "profileVersion": {
      "const": "1.0.0"
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 0,
      "maxItems": 5000
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      },
      "minItems": 0,
      "maxItems": 5000
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      },
      "minItems": 0,
      "maxItems": 5000
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      },
      "minItems": 0,
      "maxItems": 5000
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      },
      "minItems": 0,
      "maxItems": 5000
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    }
  },
  "required": ["schemaVersion", "profileVersion", "model"],
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "loop": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "standard"
            },
            "condition": {
              "$ref": "#/$defs/text"
            },
            "testBefore": {
              "type": "boolean"
            }
          },
          "required": ["kind", "condition"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "multiInstance"
            },
            "sequential": {
              "type": "boolean"
            }
          },
          "required": ["kind", "sequential"]
        }
      ]
    },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": ["none", "terminate"]
            }
          },
          "required": ["kind"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": ["message", "signal"]
            },
            "ref": {
              "$ref": "#/$defs/key"
            }
          },
          "required": ["kind", "ref"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": ["error", "escalation"]
            },
            "ref": {
              "$ref": "#/$defs/key"
            }
          },
          "required": ["kind"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "timer"
            },
            "timeDate": {
              "$ref": "#/$defs/text"
            }
          },
          "required": ["kind", "timeDate"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "timer"
            },
            "timeDuration": {
              "$ref": "#/$defs/text"
            }
          },
          "required": ["kind", "timeDuration"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "timer"
            },
            "timeCycle": {
              "$ref": "#/$defs/text"
            }
          },
          "required": ["kind", "timeCycle"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "conditional"
            },
            "condition": {
              "$ref": "#/$defs/text"
            }
          },
          "required": ["kind", "condition"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "link"
            },
            "name": {
              "$ref": "#/$defs/name"
            }
          },
          "required": ["kind", "name"]
        }
      ]
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "$ref": "#/$defs/key"
