            },
            "state": {
              "$ref": "#/$defs/name"
            }
          },
          "required": ["key", "type", "containerRef", "dataStoreRef"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "$ref": "#/$defs/key"
