            "containerRef": {
              "$ref": "#/$defs/key"
            },
            "type": {
              "enum": ["intermediateThrowEvent", "endEvent"]
            },
            "event": {
              "$ref": "#/$defs/event"
            }
          },
          "required": ["key", "type", "containerRef", "event"],
          "allOf": [
            {
              "if": {
                "properties": {
                  "event": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "enum": ["error", "escalation"]
                      }
                    },
                    "required": ["kind"]
                  }
                }
              },
              "then": {
                "properties": {
                  "event": {
                    "type": "object",
                    "properties": {
                      "ref": {
                        "$ref": "#/$defs/key"
                      }
                    },
                    "required": ["ref"]
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "$ref": "#/$defs/key"
            },
            "name": {
              "$ref": "#/$defs/name"
            },
            "documentation": {
              "$ref": "#/$defs/text"
            },
            "containerRef": {
              "$ref": "#/$defs/key"
            },
            "type": {
              "enum": ["boundaryEvent"]
            },
            "event": {
              "$ref": "#/$defs/event"
            },
            "attachedToRef": {
              "$ref": "#/$defs/key"
            },
            "interrupting": {
              "type": "boolean"
            }
          },
          "required": ["key", "type", "containerRef", "event", "attachedToRef", "interrupting"]
        }
      ]
    },
    "documentationArtifact": {
      "oneOf": [
