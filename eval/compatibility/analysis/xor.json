        "flows": [
          {
            "key": "flow1",
            "containerRef": "process",
            "sourceRef": "start",
            "targetRef": "review"
          },
          {
            "key": "flow2",
            "containerRef": "process",
            "sourceRef": "review",
            "targetRef": "decision"
          },
          {
            "key": "flow3",
            "containerRef": "process",
            "sourceRef": "decision",
            "targetRef": "approve",
