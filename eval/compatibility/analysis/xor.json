            "name": "Request rejected"
          },
          {
            "key": "flow5",
            "containerRef": "process",
            "sourceRef": "approve",
            "targetRef": "approved"
          },
          {
            "key": "flow6",
            "containerRef": "process",
            "sourceRef": "decline",
            "targetRef": "rejected"
          }
