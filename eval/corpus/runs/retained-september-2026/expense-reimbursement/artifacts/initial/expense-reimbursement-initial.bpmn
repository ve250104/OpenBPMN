<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="M_employeeExpenseReimbursement" name="Employee expense reimbursement — supported segments" targetNamespace="urn:process-model:employeeExpenseReimbursement">
  <bpmn:process id="M_expenseSegments" name="Expense reimbursement — supported segments" isExecutable="false">
    <bpmn:laneSet id="G_lanes_expenseSegments">
      <bpmn:lane id="M_employee" name="Employee">
        <bpmn:flowNodeRef>M_submissionStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_submitClaim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="M_accountsPayable" name="Accounts Payable">
        <bpmn:flowNodeRef>M_checkReceipts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_receiptsComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_returnClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_claimReturned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_approvedClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_payClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_informEmployee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_reimbursedAndInformed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="M_lineManager" name="Line manager">
        <bpmn:flowNodeRef>M_approveBusinessPurpose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_businessPurposeApproved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="M_financeController" name="Finance controller">
        <bpmn:flowNodeRef>M_approveAsController</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_controllerApproved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="M_unspecifiedRole" name="Role unspecified">
        <bpmn:flowNodeRef>M_amountKnown</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_controllerRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_controllerNotRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_rejectedClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_issueRejectionNotice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_rejectionNotified</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="M_submissionStart" name="Claim to submit">
      <bpmn:outgoing>M_beginSubmission</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="M_submitClaim" name="Submit claim">
      <bpmn:incoming>M_beginSubmission</bpmn:incoming>
      <bpmn:outgoing>M_submittedForCheck</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="M_checkReceipts" name="Check receipts">
      <bpmn:incoming>M_submittedForCheck</bpmn:incoming>
      <bpmn:outgoing>M_classifyCompleteness</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="M_receiptsComplete" name="Claim complete?">
      <bpmn:incoming>M_classifyCompleteness</bpmn:incoming>
      <bpmn:outgoing>M_incompleteClaim</bpmn:outgoing>
      <bpmn:outgoing>M_completeClaim</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="M_returnClaim" name="Return claim to employee">
      <bpmn:incoming>M_incompleteClaim</bpmn:incoming>
      <bpmn:outgoing>M_returnBoundary</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="M_claimReturned" name="Claim returned">
      <bpmn:incoming>M_returnBoundary</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="M_approveBusinessPurpose" name="Approve business purpose">
      <bpmn:incoming>M_completeClaim</bpmn:incoming>
      <bpmn:outgoing>M_managerApprovalBoundary</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="M_businessPurposeApproved" name="Business purpose approved">
      <bpmn:incoming>M_managerApprovalBoundary</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="M_amountKnown" name="Claim amount available">
      <bpmn:outgoing>M_assessControllerRequirement</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="M_controllerRequired" name="Above EUR 2,000?">
      <bpmn:incoming>M_assessControllerRequirement</bpmn:incoming>
      <bpmn:outgoing>M_aboveThreshold</bpmn:outgoing>
      <bpmn:outgoing>M_atOrBelowThreshold</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="M_approveAsController" name="Approve claim">
      <bpmn:incoming>M_aboveThreshold</bpmn:incoming>
      <bpmn:outgoing>M_controllerApprovalBoundary</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="M_controllerApproved" name="Controller approved">
      <bpmn:incoming>M_controllerApprovalBoundary</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="M_controllerNotRequired" name="Controller approval not required">
      <bpmn:incoming>M_atOrBelowThreshold</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="M_approvedClaim" name="Required approvals granted">
      <bpmn:outgoing>M_startPayment</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="M_payClaim" name="Pay approved claim">
      <bpmn:incoming>M_startPayment</bpmn:incoming>
      <bpmn:outgoing>M_notifyAfterPayment</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="M_informEmployee" name="Inform employee of payment">
      <bpmn:incoming>M_notifyAfterPayment</bpmn:incoming>
      <bpmn:outgoing>M_paymentComplete</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="M_reimbursedAndInformed" name="Paid and employee informed">
      <bpmn:incoming>M_paymentComplete</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="M_rejectedClaim" name="Claim rejected">
      <bpmn:outgoing>M_rejectedToNotice</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="M_issueRejectionNotice" name="Issue rejection notice">
      <bpmn:incoming>M_rejectedToNotice</bpmn:incoming>
      <bpmn:outgoing>M_rejectionComplete</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="M_rejectionNotified" name="Rejected with notice">
      <bpmn:incoming>M_rejectionComplete</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="M_beginSubmission" sourceRef="M_submissionStart" targetRef="M_submitClaim" />
    <bpmn:sequenceFlow id="M_submittedForCheck" sourceRef="M_submitClaim" targetRef="M_checkReceipts" />
    <bpmn:sequenceFlow id="M_classifyCompleteness" sourceRef="M_checkReceipts" targetRef="M_receiptsComplete" />
    <bpmn:sequenceFlow id="M_incompleteClaim" name="Incomplete" sourceRef="M_receiptsComplete" targetRef="M_returnClaim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Claim is incomplete</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M_returnBoundary" sourceRef="M_returnClaim" targetRef="M_claimReturned" />
    <bpmn:sequenceFlow id="M_completeClaim" name="Complete" sourceRef="M_receiptsComplete" targetRef="M_approveBusinessPurpose">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Claim is complete</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M_managerApprovalBoundary" sourceRef="M_approveBusinessPurpose" targetRef="M_businessPurposeApproved" />
    <bpmn:sequenceFlow id="M_assessControllerRequirement" sourceRef="M_amountKnown" targetRef="M_controllerRequired" />
    <bpmn:sequenceFlow id="M_aboveThreshold" name="&#62; EUR 2,000" sourceRef="M_controllerRequired" targetRef="M_approveAsController">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Claim amount &gt; EUR 2,000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M_atOrBelowThreshold" name="&#60;= EUR 2,000" sourceRef="M_controllerRequired" targetRef="M_controllerNotRequired">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Claim amount &lt;= EUR 2,000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M_controllerApprovalBoundary" sourceRef="M_approveAsController" targetRef="M_controllerApproved" />
    <bpmn:sequenceFlow id="M_startPayment" sourceRef="M_approvedClaim" targetRef="M_payClaim" />
    <bpmn:sequenceFlow id="M_notifyAfterPayment" sourceRef="M_payClaim" targetRef="M_informEmployee" />
    <bpmn:sequenceFlow id="M_paymentComplete" sourceRef="M_informEmployee" targetRef="M_reimbursedAndInformed" />
    <bpmn:sequenceFlow id="M_rejectedToNotice" sourceRef="M_rejectedClaim" targetRef="M_issueRejectionNotice" />
    <bpmn:sequenceFlow id="M_rejectionComplete" sourceRef="M_issueRejectionNotice" targetRef="M_rejectionNotified" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_diagram_M_expenseSegments">
    <bpmndi:BPMNPlane id="D_plane_M_expenseSegments" bpmnElement="M_expenseSegments">
      <bpmndi:BPMNShape id="D_shape_M_expenseSegments_M_employee" bpmnElement="M_employee" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="1002" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseSegments_M_accountsPayable" bpmnElement="M_accountsPayable" isHorizontal="true">
        <dc:Bounds x="80" y="320" width="1002" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseSegments_M_lineManager" bpmnElement="M_lineManager" isHorizontal="true">
        <dc:Bounds x="80" y="720" width="1002" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseSegments_M_financeController" bpmnElement="M_financeController" isHorizontal="true">
        <dc:Bounds x="80" y="960" width="1002" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseSegments_M_unspecifiedRole" bpmnElement="M_unspecifiedRole" isHorizontal="true">
        <dc:Bounds x="80" y="1200" width="1002" height="486" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseSegments_M_submissionStart" bpmnElement="M_submissionStart">
        <dc:Bounds x="120" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel id="D_label_M_expenseSegments_M_submissionStart">
          <dc:Bounds x="116" y="226" width="108" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseSegments_M_submitClaim" bpmnElement="M_submitClaim">
        <dc:Bounds x="256" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseSegments_M_checkReceipts" bpmnElement="M_checkReceipts">
        <dc:Bounds x="456" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseSegments_M_receiptsComplete" bpmnElement="M_receiptsComplete" isMarkerVisible="true">
        <dc:Bounds x="656" y="415" width="50" height="50" />
        <bpmndi:BPMNLabel id="D_label_M_expenseSegments_M_receiptsComplete">
          <dc:Bounds x="624.5" y="473" width="113" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseSegments_M_returnClaim" bpmnElement="M_returnClaim">
        <dc:Bounds x="806" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseSegments_M_claimReturned" bpmnElement="M_claimReturned">
        <dc:Bounds x="1006" y="422" width="36" height="36" />
        <bpmndi:BPMNLabel id="D_label_M_expenseSegments_M_claimReturned">
          <dc:Bounds x="970" y="466" width="104" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseSegments_M_approveBusinessPurpose" bpmnElement="M_approveBusinessPurpose">
        <dc:Bounds x="806" y="800" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseSegments_M_businessPurposeApproved" bpmnElement="M_businessPurposeApproved">
        <dc:Bounds x="1006" y="822" width="36" height="36" />
        <bpmndi:BPMNLabel id="D_label_M_expenseSegments_M_businessPurposeApproved">
          <dc:Bounds x="892" y="894" width="182" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseSegments_M_amountKnown" bpmnElement="M_amountKnown">
        <dc:Bounds x="120" y="1287" width="36" height="36" />
        <bpmndi:BPMNLabel id="D_label_M_expenseSegments_M_amountKnown">
          <dc:Bounds x="116" y="1331" width="155" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseSegments_M_controllerRequired" bpmnElement="M_controllerRequired" isMarkerVisible="true">
        <dc:Bounds x="281" y="1280" width="50" height="50" />
        <bpmndi:BPMNLabel id="D_label_M_expenseSegments_M_controllerRequired">
          <dc:Bounds x="245.5" y="1249" width="121" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseSegments_M_approveAsController" bpmnElement="M_approveAsController">
        <dc:Bounds x="456" y="1040" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseSegments_M_controllerApproved" bpmnElement="M_controllerApproved">
        <dc:Bounds x="663" y="1062" width="36" height="36" />
        <bpmndi:BPMNLabel id="D_label_M_expenseSegments_M_controllerApproved">
          <dc:Bounds x="613.5" y="1106" width="135" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseSegments_M_controllerNotRequired" bpmnElement="M_controllerNotRequired">
        <dc:Bounds x="488" y="1410" width="36" height="36" />
        <bpmndi:BPMNLabel id="D_label_M_expenseSegments_M_controllerNotRequired">
          <dc:Bounds x="406" y="1454" width="200" height="37" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseSegments_M_approvedClaim" bpmnElement="M_approvedClaim">
        <dc:Bounds x="120" y="582" width="36" height="36" />
        <bpmndi:BPMNLabel id="D_label_M_expenseSegments_M_approvedClaim">
          <dc:Bounds x="116" y="654" width="183" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseSegments_M_payClaim" bpmnElement="M_payClaim">
        <dc:Bounds x="256" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseSegments_M_informEmployee" bpmnElement="M_informEmployee">
        <dc:Bounds x="456" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseSegments_M_reimbursedAndInformed" bpmnElement="M_reimbursedAndInformed">
        <dc:Bounds x="663" y="582" width="36" height="36" />
        <bpmndi:BPMNLabel id="D_label_M_expenseSegments_M_reimbursedAndInformed">
          <dc:Bounds x="587" y="626" width="188" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseSegments_M_rejectedClaim" bpmnElement="M_rejectedClaim">
        <dc:Bounds x="120" y="1548" width="36" height="36" />
        <bpmndi:BPMNLabel id="D_label_M_expenseSegments_M_rejectedClaim">
          <dc:Bounds x="116" y="1592" width="100" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseSegments_M_issueRejectionNotice" bpmnElement="M_issueRejectionNotice">
        <dc:Bounds x="256" y="1526" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseSegments_M_rejectionNotified" bpmnElement="M_rejectionNotified">
        <dc:Bounds x="488" y="1548" width="36" height="36" />
        <bpmndi:BPMNLabel id="D_label_M_expenseSegments_M_rejectionNotified">
          <dc:Bounds x="438.5" y="1592" width="135" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="D_edge_M_expenseSegments_M_beginSubmission" bpmnElement="M_beginSubmission">
        <di:waypoint x="156" y="200" />
        <di:waypoint x="256" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseSegments_M_submittedForCheck" bpmnElement="M_submittedForCheck">
        <di:waypoint x="356" y="200" />
        <di:waypoint x="506" y="200" />
        <di:waypoint x="506" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseSegments_M_classifyCompleteness" bpmnElement="M_classifyCompleteness">
        <di:waypoint x="556" y="440" />
        <di:waypoint x="572" y="440" />
        <di:waypoint x="572" y="399" />
        <di:waypoint x="681" y="399" />
        <di:waypoint x="681" y="415" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseSegments_M_incompleteClaim" bpmnElement="M_incompleteClaim">
        <di:waypoint x="656" y="440" />
        <di:waypoint x="640" y="440" />
        <di:waypoint x="640" y="398" />
        <di:waypoint x="790" y="398" />
        <di:waypoint x="790" y="440" />
        <di:waypoint x="806" y="440" />
        <bpmndi:BPMNLabel id="D_label_M_expenseSegments_M_incompleteClaim">
          <dc:Bounds x="670" y="367" width="90" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseSegments_M_returnBoundary" bpmnElement="M_returnBoundary">
        <di:waypoint x="906" y="440" />
        <di:waypoint x="1006" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseSegments_M_assessControllerRequirement" bpmnElement="M_assessControllerRequirement">
        <di:waypoint x="156" y="1305" />
        <di:waypoint x="281" y="1305" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseSegments_M_aboveThreshold" bpmnElement="M_aboveThreshold">
        <di:waypoint x="331" y="1305" />
        <di:waypoint x="506" y="1305" />
        <di:waypoint x="506" y="1120" />
        <bpmndi:BPMNLabel id="D_label_M_expenseSegments_M_aboveThreshold">
          <dc:Bounds x="373.5" y="1274" width="90" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseSegments_M_controllerApprovalBoundary" bpmnElement="M_controllerApprovalBoundary">
        <di:waypoint x="556" y="1080" />
        <di:waypoint x="663" y="1080" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseSegments_M_startPayment" bpmnElement="M_startPayment">
        <di:waypoint x="156" y="600" />
        <di:waypoint x="256" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseSegments_M_notifyAfterPayment" bpmnElement="M_notifyAfterPayment">
        <di:waypoint x="356" y="600" />
        <di:waypoint x="456" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseSegments_M_paymentComplete" bpmnElement="M_paymentComplete">
        <di:waypoint x="556" y="600" />
        <di:waypoint x="663" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseSegments_M_rejectedToNotice" bpmnElement="M_rejectedToNotice">
        <di:waypoint x="156" y="1566" />
        <di:waypoint x="256" y="1566" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseSegments_M_rejectionComplete" bpmnElement="M_rejectionComplete">
        <di:waypoint x="356" y="1566" />
        <di:waypoint x="488" y="1566" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseSegments_M_completeClaim" bpmnElement="M_completeClaim">
        <di:waypoint x="706" y="440" />
        <di:waypoint x="786" y="440" />
        <di:waypoint x="786" y="840" />
        <di:waypoint x="806" y="840" />
        <bpmndi:BPMNLabel id="D_label_M_expenseSegments_M_completeClaim">
          <dc:Bounds x="794" y="628.5" width="90" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseSegments_M_atOrBelowThreshold" bpmnElement="M_atOrBelowThreshold">
        <di:waypoint x="306" y="1330" />
        <di:waypoint x="306" y="1428" />
        <di:waypoint x="488" y="1428" />
        <bpmndi:BPMNLabel id="D_label_M_expenseSegments_M_atOrBelowThreshold">
          <dc:Bounds x="314" y="1367.5" width="92" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseSegments_M_managerApprovalBoundary" bpmnElement="M_managerApprovalBoundary">
        <di:waypoint x="906" y="840" />
        <di:waypoint x="1006" y="840" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
