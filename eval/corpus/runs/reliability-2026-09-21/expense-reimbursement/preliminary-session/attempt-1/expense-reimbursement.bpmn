<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="M_expenseReimbursement" name="Expense reimbursement" targetNamespace="urn:process-model:expenseReimbursement">
  <bpmn:process id="M_expenseProcess" name="Expense reimbursement" isExecutable="false">
    <bpmn:documentation>Employee expense reimbursement from submission through correction, required approvals, payment, or rejection.</bpmn:documentation>
    <bpmn:laneSet id="G_lanes_expenseProcess">
      <bpmn:lane id="M_employeeLane" name="Employee">
        <bpmn:flowNodeRef>M_claimReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_submitClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_correctClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_claimPaid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_claimRejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="M_accountsPayableLane" name="Accounts Payable">
        <bpmn:flowNodeRef>M_checkReceipts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_receiptsComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_selectApprovals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_requiredApprovalsComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_recordRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_payClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_notifyPayment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="M_lineManagerLane" name="Line Manager">
        <bpmn:flowNodeRef>M_managerApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_managerApproved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="M_financeControllerLane" name="Finance Controller">
        <bpmn:flowNodeRef>M_controllerApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_controllerApproved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="M_claimReady" name="Expense claim ready">
      <bpmn:outgoing>M_toSubmit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="M_submitClaim" name="Submit expense claim">
      <bpmn:incoming>M_toSubmit</bpmn:incoming>
      <bpmn:outgoing>M_toReceiptCheck</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="M_checkReceipts" name="Check receipts">
      <bpmn:incoming>M_toReceiptCheck</bpmn:incoming>
      <bpmn:incoming>M_correctionToRecheck</bpmn:incoming>
      <bpmn:outgoing>M_toCompletenessDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="M_receiptsComplete" name="Receipts complete?">
      <bpmn:incoming>M_toCompletenessDecision</bpmn:incoming>
      <bpmn:outgoing>M_incompleteToCorrection</bpmn:outgoing>
      <bpmn:outgoing>M_completeToApprovals</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="M_correctClaim" name="Correct expense claim">
      <bpmn:incoming>M_incompleteToCorrection</bpmn:incoming>
      <bpmn:outgoing>M_correctionToRecheck</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:inclusiveGateway id="M_selectApprovals" name="Select required approvals">
      <bpmn:incoming>M_completeToApprovals</bpmn:incoming>
      <bpmn:outgoing>M_standardToManager</bpmn:outgoing>
      <bpmn:outgoing>M_highValueToManager</bpmn:outgoing>
      <bpmn:outgoing>M_highValueToController</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:userTask id="M_managerApproval" name="Approve business purpose">
      <bpmn:incoming>M_standardToManager</bpmn:incoming>
      <bpmn:incoming>M_highValueToManager</bpmn:incoming>
      <bpmn:outgoing>M_managerToDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="M_managerApproved" name="Business purpose approved?">
      <bpmn:incoming>M_managerToDecision</bpmn:incoming>
      <bpmn:outgoing>M_managerApprovalAccepted</bpmn:outgoing>
      <bpmn:outgoing>M_managerApprovalRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="M_controllerApproval" name="Approve high-value claim">
      <bpmn:incoming>M_highValueToController</bpmn:incoming>
      <bpmn:outgoing>M_controllerToDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="M_controllerApproved" name="Finance approval granted?">
      <bpmn:incoming>M_controllerToDecision</bpmn:incoming>
      <bpmn:outgoing>M_controllerApprovalAccepted</bpmn:outgoing>
      <bpmn:outgoing>M_controllerApprovalRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:inclusiveGateway id="M_requiredApprovalsComplete" name="Required approvals complete">
      <bpmn:incoming>M_managerApprovalAccepted</bpmn:incoming>
      <bpmn:incoming>M_controllerApprovalAccepted</bpmn:incoming>
      <bpmn:outgoing>M_approvalsToPayment</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:userTask id="M_recordRejection" name="Record rejection and notify employee">
      <bpmn:incoming>M_managerApprovalRejected</bpmn:incoming>
      <bpmn:incoming>M_controllerApprovalRejected</bpmn:incoming>
      <bpmn:outgoing>M_rejectionToEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="M_claimRejected" name="Claim rejected">
      <bpmn:incoming>M_rejectionToEnd</bpmn:incoming>
      <bpmn:terminateEventDefinition id="G_event_claimRejected" />
    </bpmn:endEvent>
    <bpmn:userTask id="M_payClaim" name="Pay approved claim">
      <bpmn:incoming>M_approvalsToPayment</bpmn:incoming>
      <bpmn:outgoing>M_paymentToNotice</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="M_notifyPayment" name="Notify employee of payment">
      <bpmn:incoming>M_paymentToNotice</bpmn:incoming>
      <bpmn:outgoing>M_noticeToPaid</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="M_claimPaid" name="Claim paid">
      <bpmn:incoming>M_noticeToPaid</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="M_toSubmit" sourceRef="M_claimReady" targetRef="M_submitClaim" />
    <bpmn:sequenceFlow id="M_toReceiptCheck" sourceRef="M_submitClaim" targetRef="M_checkReceipts" />
    <bpmn:sequenceFlow id="M_toCompletenessDecision" sourceRef="M_checkReceipts" targetRef="M_receiptsComplete" />
    <bpmn:sequenceFlow id="M_incompleteToCorrection" name="Incomplete" sourceRef="M_receiptsComplete" targetRef="M_correctClaim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The claim is missing required receipts.</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M_correctionToRecheck" sourceRef="M_correctClaim" targetRef="M_checkReceipts" />
    <bpmn:sequenceFlow id="M_completeToApprovals" name="Complete" sourceRef="M_receiptsComplete" targetRef="M_selectApprovals">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The claim contains the required receipts.</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M_standardToManager" name="EUR 2,000 or below" sourceRef="M_selectApprovals" targetRef="M_managerApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Claim amount is less than or equal to EUR 2,000.</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M_highValueToManager" name="Above EUR 2,000" sourceRef="M_selectApprovals" targetRef="M_managerApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Claim amount is greater than EUR 2,000.</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M_highValueToController" name="Above EUR 2,000" sourceRef="M_selectApprovals" targetRef="M_controllerApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Claim amount is greater than EUR 2,000.</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M_managerToDecision" sourceRef="M_managerApproval" targetRef="M_managerApproved" />
    <bpmn:sequenceFlow id="M_managerApprovalAccepted" name="Approved" sourceRef="M_managerApproved" targetRef="M_requiredApprovalsComplete">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The line manager approves the business purpose.</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M_managerApprovalRejected" name="Rejected" sourceRef="M_managerApproved" targetRef="M_recordRejection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The line manager rejects the business purpose.</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M_controllerToDecision" sourceRef="M_controllerApproval" targetRef="M_controllerApproved" />
    <bpmn:sequenceFlow id="M_controllerApprovalAccepted" name="Approved" sourceRef="M_controllerApproved" targetRef="M_requiredApprovalsComplete">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The Finance Controller approves the high-value claim.</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M_controllerApprovalRejected" name="Rejected" sourceRef="M_controllerApproved" targetRef="M_recordRejection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The Finance Controller rejects the high-value claim.</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M_rejectionToEnd" sourceRef="M_recordRejection" targetRef="M_claimRejected" />
    <bpmn:sequenceFlow id="M_approvalsToPayment" sourceRef="M_requiredApprovalsComplete" targetRef="M_payClaim" />
    <bpmn:sequenceFlow id="M_paymentToNotice" sourceRef="M_payClaim" targetRef="M_notifyPayment" />
    <bpmn:sequenceFlow id="M_noticeToPaid" sourceRef="M_notifyPayment" targetRef="M_claimPaid" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_diagram_M_expenseProcess">
    <bpmndi:BPMNPlane id="D_plane_M_expenseProcess" bpmnElement="M_expenseProcess">
      <bpmndi:BPMNShape id="D_shape_M_expenseProcess_M_employeeLane" bpmnElement="M_employeeLane" isHorizontal="true">
