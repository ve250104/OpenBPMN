        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseProcess_M_highValueToController" bpmnElement="M_highValueToController">
        <di:waypoint x="831" y="600" />
        <di:waypoint x="815" y="600" />
        <di:waypoint x="815" y="551" />
        <di:waypoint x="1122" y="551" />
        <di:waypoint x="1122" y="1234" />
        <di:waypoint x="1106" y="1234" />
        <bpmndi:BPMNLabel id="D_label_M_expenseProcess_M_highValueToController">
          <dc:Bounds x="911" y="520" width="115" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseProcess_M_managerApprovalRejected" bpmnElement="M_managerApprovalRejected">
        <di:waypoint x="1231" y="989" />
        <di:waypoint x="1231" y="767" />
        <di:waypoint x="1356" y="767" />
        <bpmndi:BPMNLabel id="D_label_M_expenseProcess_M_managerApprovalRejected">
          <dc:Bounds x="1133" y="866.5" width="90" height="23" />
