{
  "schemaVersion": "1.0.0",
  "profileVersion": "1.0.0",
  "model": {
    "key": "expenseReimbursement",
    "name": "Expense reimbursement",
    "documentation": "Employee expense reimbursement from submission through correction, required approvals, payment, or rejection.",
    "primaryRef": "expenseProcess",
    "processes": [
      {
        "key": "expenseProcess",
        "name": "Expense reimbursement",
        "nodes": [
          { "key": "claimReady", "type": "startEvent", "containerRef": "expenseProcess", "name": "Expense claim ready", "event": { "kind": "none" } },
          { "key": "submitClaim", "type": "userTask", "containerRef": "expenseProcess", "name": "Submit expense claim" },
          { "key": "checkReceipts", "type": "userTask", "containerRef": "expenseProcess", "name": "Check receipts" },
          { "key": "receiptsComplete", "type": "exclusiveGateway", "containerRef": "expenseProcess", "name": "Receipts complete?" },
          { "key": "correctClaim", "type": "userTask", "containerRef": "expenseProcess", "name": "Correct expense claim" },
          { "key": "selectApprovals", "type": "inclusiveGateway", "containerRef": "expenseProcess", "name": "Select required approvals" },
          { "key": "managerApproval", "type": "userTask", "containerRef": "expenseProcess", "name": "Approve business purpose" },
          { "key": "managerApproved", "type": "exclusiveGateway", "containerRef": "expenseProcess", "name": "Business purpose approved?" },
          { "key": "controllerApproval", "type": "userTask", "containerRef": "expenseProcess", "name": "Approve high-value claim" },
          { "key": "controllerApproved", "type": "exclusiveGateway", "containerRef": "expenseProcess", "name": "Finance approval granted?" },
          { "key": "requiredApprovalsComplete", "type": "inclusiveGateway", "containerRef": "expenseProcess", "name": "Required approvals complete" },
          { "key": "recordRejection", "type": "userTask", "containerRef": "expenseProcess", "name": "Record rejection and notify employee" },
          { "key": "claimRejected", "type": "endEvent", "containerRef": "expenseProcess", "name": "Claim rejected", "event": { "kind": "terminate" } },
          { "key": "payClaim", "type": "userTask", "containerRef": "expenseProcess", "name": "Pay approved claim" },
          { "key": "notifyPayment", "type": "userTask", "containerRef": "expenseProcess", "name": "Notify employee of payment" },
          { "key": "claimPaid", "type": "endEvent", "containerRef": "expenseProcess", "name": "Claim paid", "event": { "kind": "none" } }
        ],
        "flows": [
          { "key": "toSubmit", "containerRef": "expenseProcess", "sourceRef": "claimReady", "targetRef": "submitClaim" },
          { "key": "toReceiptCheck", "containerRef": "expenseProcess", "sourceRef": "submitClaim", "targetRef": "checkReceipts" },
          { "key": "toCompletenessDecision", "containerRef": "expenseProcess", "sourceRef": "checkReceipts", "targetRef": "receiptsComplete" },
          { "key": "incompleteToCorrection", "containerRef": "expenseProcess", "sourceRef": "receiptsComplete", "targetRef": "correctClaim", "name": "Incomplete", "condition": "The claim is missing required receipts." },
          { "key": "correctionToRecheck", "containerRef": "expenseProcess", "sourceRef": "correctClaim", "targetRef": "checkReceipts" },
          { "key": "completeToApprovals", "containerRef": "expenseProcess", "sourceRef": "receiptsComplete", "targetRef": "selectApprovals", "name": "Complete", "condition": "The claim contains the required receipts." },
          { "key": "standardToManager", "containerRef": "expenseProcess", "sourceRef": "selectApprovals", "targetRef": "managerApproval", "name": "EUR 2,000 or below", "condition": "Claim amount is less than or equal to EUR 2,000." },
          { "key": "highValueToManager", "containerRef": "expenseProcess", "sourceRef": "selectApprovals", "targetRef": "managerApproval", "name": "Above EUR 2,000", "condition": "Claim amount is greater than EUR 2,000." },
          { "key": "highValueToController", "containerRef": "expenseProcess", "sourceRef": "selectApprovals", "targetRef": "controllerApproval", "name": "Above EUR 2,000", "condition": "Claim amount is greater than EUR 2,000." },
          { "key": "managerToDecision", "containerRef": "expenseProcess", "sourceRef": "managerApproval", "targetRef": "managerApproved" },
          { "key": "managerApprovalAccepted", "containerRef": "expenseProcess", "sourceRef": "managerApproved", "targetRef": "requiredApprovalsComplete", "name": "Approved", "condition": "The line manager approves the business purpose." },
          { "key": "managerApprovalRejected", "containerRef": "expenseProcess", "sourceRef": "managerApproved", "targetRef": "recordRejection", "name": "Rejected", "condition": "The line manager rejects the business purpose." },
          { "key": "controllerToDecision", "containerRef": "expenseProcess", "sourceRef": "controllerApproval", "targetRef": "controllerApproved" },
          { "key": "controllerApprovalAccepted", "containerRef": "expenseProcess", "sourceRef": "controllerApproved", "targetRef": "requiredApprovalsComplete", "name": "Approved", "condition": "The Finance Controller approves the high-value claim." },
          { "key": "controllerApprovalRejected", "containerRef": "expenseProcess", "sourceRef": "controllerApproved", "targetRef": "recordRejection", "name": "Rejected", "condition": "The Finance Controller rejects the high-value claim." },
          { "key": "rejectionToEnd", "containerRef": "expenseProcess", "sourceRef": "recordRejection", "targetRef": "claimRejected" },
          { "key": "approvalsToPayment", "containerRef": "expenseProcess", "sourceRef": "requiredApprovalsComplete", "targetRef": "payClaim" },
          { "key": "paymentToNotice", "containerRef": "expenseProcess", "sourceRef": "payClaim", "targetRef": "notifyPayment" },
          { "key": "noticeToPaid", "containerRef": "expenseProcess", "sourceRef": "notifyPayment", "targetRef": "claimPaid" }
        ],
        "lanes": [
          { "key": "employeeLane", "name": "Employee", "parentRef": "expenseProcess", "flowNodeRefs": ["claimReady", "submitClaim", "correctClaim", "claimPaid", "claimRejected"] },
          { "key": "accountsPayableLane", "name": "Accounts Payable", "parentRef": "expenseProcess", "flowNodeRefs": ["checkReceipts", "receiptsComplete", "selectApprovals", "requiredApprovalsComplete", "recordRejection", "payClaim", "notifyPayment"] },
          { "key": "lineManagerLane", "name": "Line Manager", "parentRef": "expenseProcess", "flowNodeRefs": ["managerApproval", "managerApproved"] },
          { "key": "financeControllerLane", "name": "Finance Controller", "parentRef": "expenseProcess", "flowNodeRefs": ["controllerApproval", "controllerApproved"] }
        ]
      }
    ]
  },
  "evidence": [
    { "key": "procedure", "source": "Expense reimbursement procedure", "summary": "Employees submit claims; Accounts Payable checks receipts and returns incomplete claims; the line manager approves business purpose; claims above EUR 2,000 also require Finance Controller approval; Accounts Payable pays approved claims and informs the employee; rejected claims end with a notice.", "locator": "inputs/procedure.txt" },
    { "key": "employeeInterview", "source": "Employee interview, 2026-08-18", "summary": "The employee submits the expense form with receipt images, corrects the same claim when incomplete, and receives a notice when it is rejected or paid.", "locator": "inputs/interviews.txt, employee interview" },
    { "key": "managerInterview", "source": "Line manager interview, 2026-08-19", "summary": "The line manager decides business purpose; Finance Controller approval is also required above EUR 2,000; no approval order is prescribed; Accounts Payable pays only after every required approval is present.", "locator": "inputs/interviews.txt, line manager interview" },
    { "key": "policy", "source": "Expense reimbursement control note, effective 2026-01-01", "summary": "Accounts Payable checks required receipts; incomplete claims loop for same-claim correction; business-purpose approval is required; claims above EUR 2,000 additionally require Finance Controller approval without prescribed order; Accounts Payable records payment or rejection and sends the corresponding employee notice.", "locator": "inputs/policy.txt, clauses 1-6" }
  ],
  "decisions": [
    { "key": "sameClaimRecheck", "description": "Represent incomplete-claim correction as a loop back to receipt checking under the same claim identity.", "elementRefs": ["incompleteToCorrection", "correctClaim", "correctionToRecheck"], "evidenceRefs": ["employeeInterview", "policy"] },
    { "key": "unorderedConditionalApprovals", "description": "Use an inclusive split and join so line-manager approval is always selected and Finance Controller approval is additionally selected above the threshold, without prescribing an order between them.", "elementRefs": ["selectApprovals", "standardToManager", "highValueToManager", "highValueToController", "requiredApprovalsComplete"], "evidenceRefs": ["managerInterview", "policy"] },
    { "key": "rejectionTerminatesApprovals", "description": "A rejection ends the claim and terminates any other active approval branch after Accounts Payable records the rejection and notifies the employee.", "elementRefs": ["managerApprovalRejected", "controllerApprovalRejected", "recordRejection", "claimRejected"], "evidenceRefs": ["procedure", "policy"] }
  ],
  "links": [
    { "elementRef": "submitClaim", "assertion": "The employee submits the expense claim.", "basis": "evidence", "supportRefs": ["procedure", "employeeInterview"] },
    { "elementRef": "checkReceipts", "assertion": "Accounts Payable checks required receipts.", "basis": "evidence", "supportRefs": ["procedure", "policy"] },
    { "elementRef": "correctClaim", "assertion": "An incomplete claim is corrected under the same identity and checked again.", "basis": "decision", "supportRefs": ["sameClaimRecheck"] },
    { "elementRef": "selectApprovals", "assertion": "Required approvals are selected without imposing an order.", "basis": "decision", "supportRefs": ["unorderedConditionalApprovals"] },
    { "elementRef": "managerApproval", "assertion": "The line manager approves business purpose for every claim.", "basis": "evidence", "supportRefs": ["procedure", "managerInterview", "policy"] },
    { "elementRef": "controllerApproval", "assertion": "Finance Controller approval is required above EUR 2,000.", "basis": "evidence", "supportRefs": ["procedure", "managerInterview", "policy"] },
    { "elementRef": "requiredApprovalsComplete", "assertion": "Payment waits until every selected approval is present.", "basis": "evidence", "supportRefs": ["managerInterview", "policy"] },
    { "elementRef": "recordRejection", "assertion": "Accounts Payable records rejection and notifies the employee.", "basis": "evidence", "supportRefs": ["procedure", "policy"] },
    { "elementRef": "payClaim", "assertion": "Accounts Payable pays approved claims.", "basis": "evidence", "supportRefs": ["procedure", "policy"] },
    { "elementRef": "notifyPayment", "assertion": "Accounts Payable sends the employee the payment notice.", "basis": "evidence", "supportRefs": ["procedure", "employeeInterview", "policy"] }
  ],
  "scenarios": [
    { "key": "standardClaimPaid", "name": "Complete claim at or below EUR 2,000 is paid", "startRef": "claimReady", "steps": ["submitClaim", "checkReceipts", "receiptsComplete", "selectApprovals", "managerApproval", "managerApproved", "requiredApprovalsComplete", "payClaim", "notifyPayment", "claimPaid"], "expectedOutcome": "The line manager approves business purpose, Accounts Payable pays the claim, and the employee is notified.", "evidenceRefs": ["procedure", "managerInterview", "policy"] },
    { "key": "highValueClaimPaid", "name": "Complete claim above EUR 2,000 is paid", "startRef": "claimReady", "steps": ["submitClaim", "checkReceipts", "receiptsComplete", "selectApprovals", "managerApproval", "controllerApproval", "managerApproved", "controllerApproved", "requiredApprovalsComplete", "payClaim", "notifyPayment", "claimPaid"], "expectedOutcome": "Both required approvals complete without prescribed order before Accounts Payable pays and notifies the employee.", "evidenceRefs": ["procedure", "managerInterview", "policy"] },
    { "key": "incompleteClaimCorrected", "name": "Incomplete claim is corrected and rechecked", "startRef": "claimReady", "steps": ["submitClaim", "checkReceipts", "receiptsComplete", "correctClaim", "checkReceipts"], "expectedOutcome": "The same claim returns to receipt checking after employee correction.", "evidenceRefs": ["employeeInterview", "policy"] },
    { "key": "claimRejectedScenario", "name": "Required approval is rejected", "startRef": "claimReady", "steps": ["submitClaim", "checkReceipts", "receiptsComplete", "selectApprovals", "managerApproval", "managerApproved", "recordRejection", "claimRejected"], "expectedOutcome": "Accounts Payable records rejection, notifies the employee, and the claim ends without payment.", "evidenceRefs": ["procedure", "policy"] }
  ],
  "presentation": {
    "direction": "leftToRight",
    "laneOrder": ["employeeLane", "accountsPayableLane", "lineManagerLane", "financeControllerLane"]
  }
}
