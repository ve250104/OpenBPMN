        <dc:Bounds x="1856" y="720" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseReimbursementProcess_M_sendRejectionNotice" bpmnElement="M_sendRejectionNotice">
        <dc:Bounds x="2056" y="720" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseReimbursementProcess_M_claimRejected" bpmnElement="M_claimRejected">
        <dc:Bounds x="2256" y="742" width="36" height="36" />
        <bpmndi:BPMNLabel id="D_label_M_expenseReimbursementProcess_M_claimRejected">
          <dc:Bounds x="2224" y="786" width="100" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="D_edge_M_expenseReimbursementProcess_M_flowClaimReadyToSubmit" bpmnElement="M_flowClaimReadyToSubmit">
        <di:waypoint x="156" y="200" />
        <di:waypoint x="256" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseReimbursementProcess_M_flowSubmitToReceiptCheck" bpmnElement="M_flowSubmitToReceiptCheck">
        <di:waypoint x="356" y="200" />
        <di:waypoint x="440" y="200" />
        <di:waypoint x="440" y="600" />
        <di:waypoint x="456" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseReimbursementProcess_M_flowReceiptCheckToCompleteness" bpmnElement="M_flowReceiptCheckToCompleteness">
        <di:waypoint x="556" y="600" />
        <di:waypoint x="656" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseReimbursementProcess_M_flowCompleteToReviews" bpmnElement="M_flowCompleteToReviews">
        <di:waypoint x="706" y="600" />
        <di:waypoint x="722" y="600" />
        <di:waypoint x="722" y="559" />
        <di:waypoint x="856" y="559" />
        <di:waypoint x="856" y="575" />
        <bpmndi:BPMNLabel id="D_label_M_expenseReimbursementProcess_M_flowCompleteToReviews">
          <dc:Bounds x="730" y="568" width="90" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseReimbursementProcess_M_flowReviewsToManager" bpmnElement="M_flowReviewsToManager">
        <di:waypoint x="831" y="600" />
        <di:waypoint x="773.5" y="600" />
        <di:waypoint x="773.5" y="1000" />
        <di:waypoint x="1006" y="1000" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseReimbursementProcess_M_flowManagerToJoin" bpmnElement="M_flowManagerToJoin">
        <di:waypoint x="1106" y="1000" />
        <di:waypoint x="1182" y="1000" />
        <di:waypoint x="1182" y="600" />
        <di:waypoint x="1556" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseReimbursementProcess_M_flowReviewsToApprovalCheck" bpmnElement="M_flowReviewsToApprovalCheck">
        <di:waypoint x="1581" y="575" />
        <di:waypoint x="1581" y="559" />
        <di:waypoint x="1626" y="559" />
        <di:waypoint x="1626" y="600" />
        <di:waypoint x="1706" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseReimbursementProcess_M_flowApprovedToPayment" bpmnElement="M_flowApprovedToPayment">
        <di:waypoint x="1756" y="600" />
        <di:waypoint x="1856" y="600" />
        <bpmndi:BPMNLabel id="D_label_M_expenseReimbursementProcess_M_flowApprovedToPayment">
          <dc:Bounds x="1761" y="608" width="90" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseReimbursementProcess_M_flowPaymentToNotice" bpmnElement="M_flowPaymentToNotice">
        <di:waypoint x="1956" y="600" />
        <di:waypoint x="2056" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseReimbursementProcess_M_flowPaymentNoticeToPaid" bpmnElement="M_flowPaymentNoticeToPaid">
        <di:waypoint x="2156" y="600" />
        <di:waypoint x="2256" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseReimbursementProcess_M_controllerRequired" bpmnElement="M_controllerRequired">
        <di:waypoint x="1031" y="760" />
        <di:waypoint x="1015" y="760" />
        <di:waypoint x="1015" y="718" />
        <di:waypoint x="1286" y="718" />
        <di:waypoint x="1286" y="1200" />
        <bpmndi:BPMNLabel id="D_label_M_expenseReimbursementProcess_M_controllerRequired">
          <dc:Bounds x="881" y="727.5" width="126" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_edge_M_expenseReimbursementProcess_M_flowControllerDecisionToMerge" bpmnElement="M_flowControllerDecisionToMerge">
        <di:waypoint x="1206" y="1240" />
        <di:waypoint x="1190" y="1240" />
        <di:waypoint x="1190" y="719" />
        <di:waypoint x="1431" y="719" />
