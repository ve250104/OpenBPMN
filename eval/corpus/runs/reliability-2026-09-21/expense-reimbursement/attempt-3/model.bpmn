        <bpmndi:BPMNLabel id="D_label_M_expenseReimbursementProcess_M_requiredApprovalsJoin">
          <dc:Bounds x="1492" y="633" width="178" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
