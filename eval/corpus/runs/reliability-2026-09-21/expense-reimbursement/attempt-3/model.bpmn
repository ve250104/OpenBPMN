        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseReimbursementProcess_M_correctClaim" bpmnElement="M_correctClaim">
        <dc:Bounds x="806" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_shape_M_expenseReimbursementProcess_M_splitRequiredReviews" bpmnElement="M_splitRequiredReviews" isMarkerVisible="true">
        <dc:Bounds x="831" y="575" width="50" height="50" />
        <bpmndi:BPMNLabel id="D_label_M_expenseReimbursementProcess_M_splitRequiredReviews">
