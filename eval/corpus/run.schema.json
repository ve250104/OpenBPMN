{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openbpmn:evaluation:run:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "runContractVersion": { "const": "1.0.0" },
    "runId": { "type": ["string", "null"] },
    "familyId": { "type": "string", "minLength": 1 },
    "caseId": { "type": "string", "minLength": 1 },
    "variantId": { "type": ["string", "null"] },
    "caseSha256": { "$ref": "#/$defs/identity" },
    "assertionSha256": { "$ref": "#/$defs/identity" },
    "sourceArtifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit": { "type": "string", "minLength": 1 },
        "buildIdentity": { "type": "string", "minLength": 1 },
        "dirtyState": { "type": "string", "minLength": 1 }
      },
      "required": ["commit", "buildIdentity", "dirtyState"]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "browser": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 }
      },
      "required": ["runtime", "platform", "architecture", "browser", "host"]
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "version": { "type": "string", "minLength": 1 } },
      "required": ["version"]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "reasoningSettings": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "reasoningSettings"]
    },
    "prompt": { "type": "string", "minLength": 1 },
    "answers": { "type": "array", "items": { "type": "string" } },
    "attemptCount": { "type": "integer", "minimum": 0 },
    "attempts": { "type": "array", "items": { "$ref": "#/$defs/attempt" } },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["isolated", "not_isolated"] },
        "stagingSeparation": { "type": "string", "minLength": 1 },
        "filesystemBoundary": { "type": "string", "minLength": 1 },
        "reviewerFilesAccessibleFromHost": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 },
        "canaryCheck": { "enum": ["absent_from_staged_files", "detected"] }
      },
      "required": [
        "status",
        "stagingSeparation",
        "filesystemBoundary",
        "reviewerFilesAccessibleFromHost",
        "reason",
        "canaryCheck"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokens": { "type": ["number", "null"], "minimum": 0 },
        "cost": { "type": ["number", "null"], "minimum": 0 },
        "humanCorrectionMinutes": { "type": ["number", "null"], "minimum": 0 }
      },
      "required": ["tokens", "cost", "humanCorrectionMinutes"]
    },
    "preparedAt": { "type": "string", "minLength": 1 }
  },
  "required": [
    "runContractVersion",
    "runId",
    "familyId",
    "caseId",
    "variantId",
    "caseSha256",
    "assertionSha256",
    "sourceArtifacts",
    "candidate",
    "environment",
    "skill",
    "model",
    "prompt",
    "answers",
    "attemptCount",
    "attempts",
    "isolation",
    "metrics",
    "preparedAt"
  ],
  "$defs": {
    "identity": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "path": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string" },
        "sha256": { "$ref": "#/$defs/identity" }
      },
      "required": ["path", "sha256"]
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attemptId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["completed", "failed", "blocked", "unsupported", "not_run"] },
        "reason": { "type": "string" },
        "startedAt": { "type": ["string", "null"] },
        "finishedAt": { "type": ["string", "null"] },
        "commands": { "type": "array", "items": { "type": "string" } },
        "exitResults": { "type": "array", "items": { "type": "object" } },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
        "conversation": { "type": "array" },
        "toolCalls": { "type": "array" },
        "finalClaims": { "type": "array" },
        "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } }
      },
      "required": [
        "attemptId",
        "status",
        "startedAt",
        "finishedAt",
        "commands",
        "exitResults",
        "artifacts",
        "conversation",
        "toolCalls",
        "finalClaims",
        "observations"
      ]
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 }
      },
      "required": ["artifact", "locator"]
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      },
      "required": ["identity", "role"]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assertionId": { "type": "string", "minLength": 1 },
        "method": { "enum": ["agent", "human"] },
        "methodDescription": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail", "blocked", "unsupported", "not_applicable", "unresolved"] },
        "reviewer": { "$ref": "#/$defs/reviewer" },
        "sourceCitations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/citation" }
        },
        "outputCitations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/citation" }
        },
        "adjudicationStatus": { "enum": ["proposed", "adjudicated", "not_adjudicated"] },
        "code": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "required": [
        "assertionId",
        "method",
        "methodDescription",
        "status",
        "reviewer",
        "sourceCitations",
        "outputCitations",
        "adjudicationStatus"
      ]
    }
  }
}
