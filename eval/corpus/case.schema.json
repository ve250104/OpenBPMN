{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openbpmn:evaluation:case:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "caseVersion": { "const": "1.0.0" },
    "familyId": { "$ref": "#/$defs/id" },
    "caseId": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/text" },
    "primaryTask": { "enum": ["description", "discovery", "legacy", "maintenance"] },
    "evaluationLane": { "$ref": "#/$defs/id" },
    "businessDomain": { "$ref": "#/$defs/id" },
    "partition": { "enum": ["development", "known-regression", "held-out"] },
    "upstreamOverlapGroup": { "$ref": "#/$defs/id" },
    "knownRegression": { "type": "boolean" },
    "difficultyTags": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "coverage": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/id" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt": { "$ref": "#/$defs/text" },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requested": { "$ref": "#/$defs/text" },
            "excluded": { "type": "array", "items": { "$ref": "#/$defs/text" } }
          },
          "required": ["requested", "excluded"]
        },
        "clarificationAnswers": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "correctionTurns": { "type": "array", "items": { "$ref": "#/$defs/text" } }
      },
      "required": ["prompt", "scope", "clarificationAnswers", "correctionTurns"]
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["supported", "unsupported"] },
        "capability": { "$ref": "#/$defs/id" },
        "reason": { "$ref": "#/$defs/text" },
        "fixedBeforeExecution": { "const": true }
      },
      "required": ["status", "capability", "reason", "fixedBeforeExecution"]
    },
    "sourceArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceArtifact" }
    },
    "reviewerMaterial": { "type": "string", "pattern": "^reviewer/[^/]+\\.json$" },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["meaning-preserving", "meaning-changing", "information-removing"] },
          "partition": { "enum": ["development", "known-regression", "held-out"] },
          "prompt": { "$ref": "#/$defs/text" },
          "replacesSourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          },
          "inputArtifacts": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/sourceArtifact" }
          },
          "stableAssertionIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
          "changedAssertionIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
        },
        "required": [
          "id",
          "kind",
          "partition",
          "prompt",
          "replacesSourceIds",
          "inputArtifacts",
          "stableAssertionIds",
          "changedAssertionIds"
        ]
      }
    },
    "reviewStatus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "machineIntegrity": { "enum": ["pass-at-authored-version", "not_run"] },
        "independentAgentReview": { "enum": ["completed-for-consistency", "not_run"] },
        "expertAdjudication": { "enum": ["completed", "not_run"] },
        "humanUsabilityReview": { "enum": ["completed", "not_run"] }
      },
      "required": ["machineIntegrity", "independentAgentReview", "expertAdjudication", "humanUsabilityReview"]
    }
  },
  "required": [
    "caseVersion",
    "familyId",
    "caseId",
    "title",
    "primaryTask",
    "evaluationLane",
    "businessDomain",
    "partition",
    "upstreamOverlapGroup",
    "knownRegression",
    "difficultyTags",
    "coverage",
    "task",
    "applicability",
    "sourceArtifacts",
    "reviewerMaterial",
    "variants",
    "reviewStatus"
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "license": { "$ref": "#/$defs/text" },
        "licenseUrl": { "type": "string", "pattern": "^https://" },
        "attribution": { "$ref": "#/$defs/text" }
      },
      "required": ["license", "licenseUrl", "attribution"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": [
            "public-academic",
            "synthetic-fiction",
            "public-institutional",
            "semi-synthetic",
            "permissioned-operational"
          ]
        },
        "sourceFamily": { "$ref": "#/$defs/text" },
        "sourceVersion": { "$ref": "#/$defs/text" },
        "originalUrl": { "type": ["string", "null"] },
        "authorshipRecord": { "$ref": "#/$defs/text" },
        "retrievedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "rights": { "$ref": "#/$defs/rights" }
      },
      "required": ["classification", "sourceFamily", "sourceVersion", "originalUrl", "retrievedAt", "rights"]
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/path" },
        "mediaType": { "$ref": "#/$defs/text" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "role": { "$ref": "#/$defs/text" },
        "viewpoint": { "$ref": "#/$defs/text" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "transformationHistory": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }
      },
      "required": ["id", "path", "mediaType", "sha256", "role", "viewpoint", "provenance", "transformationHistory"]
    }
  }
}
