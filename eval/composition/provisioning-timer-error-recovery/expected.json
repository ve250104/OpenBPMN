  "scenarios": [
    {
      "name": "Normal provisioning",
      "path": [
        "M_requested",
        "M_provision",
        "M_ready"
      ],
      "expected": "Successful completion does not traverse recovery."
    },
    {
      "name": "Slow provisioning",
      "path": [
        "M_late",
        "M_remind",
        "M_reminded"
      ],
      "expected": "The dashed timer boundary launches an update without cancelling provisioning."
    },
    {
      "name": "Repair and retry",
      "path": [
        "M_failed",
        "M_investigate",
        "M_recoverable",
        "M_provision"
      ],
      "expected": "The error interrupts provisioning; only an explicit safe-retry decision retries."
    },
    {
      "name": "Unrecoverable failure",
      "path": [
        "M_failed",
        "M_investigate",
        "M_recoverable",
        "M_unable"
      ],
      "expected": "The default exit throws the named provisioning error."
    }
  ],
  "review": {
    "reference": "Both boundaries touch only the provisioning task; the timer is dashed, the error solid, and the retry return remains distinguishable.",
