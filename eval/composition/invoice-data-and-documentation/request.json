  "model": {
    "key": "invoice-data-model",
    "name": "Invoice evidence and booking records",
    "primaryRef": "invoice-review",
    "declarations": [
      {
        "key": "invoice-message",
        "type": "message",
        "name": "Supplier invoice"
      },
      {
        "key": "receipt-message",
        "type": "message",
        "name": "Booking confirmation"
      },
      {
        "key": "ledger",
        "type": "dataStore",
        "name": "Accounting ledger",
        "capacity": 100000,
        "unlimited": false
      },
      {
        "key": "controls-category",
        "type": "category",
        "name": "Control",
        "value": "Invoice evidence"
      }
    ],
    "processes": [
      {
        "key": "invoice-review",
        "name": "Review and record a supplier invoice",
        "documentation": "Preserve the invoice and the stated review policy.",
        "nodes": [
          {
            "key": "received",
            "type": "startEvent",
            "containerRef": "invoice-review",
            "name": "Invoice received",
            "event": {
              "kind": "message",
              "ref": "invoice-message"
            }
          },
          {
            "key": "review",
            "type": "userTask",
            "containerRef": "invoice-review",
            "name": "Review and book invoice"
          },
          {
            "key": "confirmed",
            "type": "endEvent",
            "containerRef": "invoice-review",
            "name": "Booking confirmed",
            "event": {
              "kind": "message",
              "ref": "receipt-message"
            }
          }
        ],
        "flows": [
          {
            "key": "d1",
            "containerRef": "invoice-review",
            "sourceRef": "received",
            "targetRef": "review"
          },
          {
            "key": "d2",
            "containerRef": "invoice-review",
            "sourceRef": "review",
            "targetRef": "confirmed"
          }
        ],
        "artifacts": [
          {
            "key": "invoice-data",
            "type": "dataObject",
            "containerRef": "invoice-review",
            "name": "Invoice"
          },
          {
            "key": "booking-data",
            "type": "dataObject",
            "containerRef": "invoice-review",
            "name": "Booking"
          },
          {
            "key": "invoice-ref",
            "type": "dataObjectReference",
            "containerRef": "invoice-review",
            "dataObjectRef": "invoice-data",
            "name": "Supplier invoice",
            "state": "received"
          },
          {
            "key": "booking-ref",
            "type": "dataObjectReference",
            "containerRef": "invoice-review",
            "dataObjectRef": "booking-data",
            "name": "Booking record",
            "state": "reviewed"
          },
          {
            "key": "ledger-ref",
            "type": "dataStoreReference",
            "containerRef": "invoice-review",
            "dataStoreRef": "ledger",
            "name": "Accounting ledger"
          },
          {
            "key": "policy",
            "type": "dataInput",
            "ownerRef": "invoice-review",
            "name": "Review policy"
          },
          {
            "key": "result",
            "type": "dataOutput",
            "ownerRef": "invoice-review",
            "name": "Recorded booking"
          },
          {
            "key": "event-payload",
            "type": "dataOutput",
            "ownerRef": "received",
            "name": "Invoice payload"
          },
          {
            "key": "invoice-input",
            "type": "dataInput",
            "ownerRef": "review",
            "name": "Invoice for review"
          },
          {
            "key": "policy-input",
            "type": "dataInput",
            "ownerRef": "review",
            "name": "Applicable policy"
          },
          {
            "key": "booking-output",
            "type": "dataOutput",
            "ownerRef": "review",
            "name": "Approved booking"
          },
          {
            "key": "confirmation-input",
            "type": "dataInput",
            "ownerRef": "confirmed",
            "name": "Confirmation payload"
          },
          {
            "key": "note",
            "type": "textAnnotation",
            "containerRef": "invoice-review",
            "text": "Retain the original invoice with its booking evidence."
          },
          {
            "key": "evidence-group",
            "type": "group",
            "containerRef": "invoice-review",
            "categoryRef": "controls-category",
            "memberRefs": [
              "review",
              "invoice-ref",
              "booking-ref"
            ]
          },
          {
            "key": "explains",
            "type": "association",
            "containerRef": "invoice-review",
            "sourceRef": "note",
            "targetRef": "review",
            "direction": "none"
          }
        ],
        "dataAssociations": [
          {
            "key": "capture",
            "direction": "output",
            "ownerRef": "received",
            "sourceRefs": [
              "event-payload"
            ],
            "targetRef": "invoice-ref"
          },
          {
            "key": "consume",
            "direction": "input",
            "ownerRef": "review",
            "sourceRefs": [
              "invoice-ref"
            ],
            "targetRef": "invoice-input"
          },
          {
            "key": "apply-policy",
            "direction": "input",
            "ownerRef": "review",
            "sourceRefs": [
              "policy"
            ],
            "targetRef": "policy-input"
          },
          {
            "key": "produce",
            "direction": "output",
            "ownerRef": "review",
            "sourceRefs": [
              "booking-output"
            ],
            "targetRef": "booking-ref"
          },
          {
            "key": "persist",
            "direction": "output",
            "ownerRef": "review",
            "sourceRefs": [
              "booking-output"
            ],
            "targetRef": "ledger-ref"
          },
          {
            "key": "emit",
            "direction": "input",
            "ownerRef": "confirmed",
            "sourceRefs": [
              "booking-ref"
            ],
            "targetRef": "confirmation-input"
          },
          {
            "key": "return-result",
            "direction": "output",
            "ownerRef": "review",
            "sourceRefs": [
              "booking-output"
            ],
            "targetRef": "result"
          }
        ]
      }
